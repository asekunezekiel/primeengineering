# ---------- Frontend (safe to expose; bundled into the browser) ----------
# Public site URL, used for canonical links, Open Graph, sitemap and robots.txt.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL if left empty.
SITE_URL=
# Public contact email shown on the site.
VITE_CONTACT_EMAIL=proengineers.team@gmail.com
# Cloudflare Turnstile SITE key (public). Leave empty to hide the widget.
VITE_TURNSTILE_SITE_KEY=

# ---------- Server only (set in Vercel project settings, never commit) ----------
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where inquiries are delivered.
INQUIRY_TO_EMAIL=proengineers.team@gmail.com
# Verified sender, e.g. "PrimeBuild Website <inquiries@yourdomain.com>".
INQUIRY_FROM_EMAIL=
# Cloudflare Turnstile SECRET key. When set, the server requires a valid token.
TURNSTILE_SECRET_KEY=
# Optional comma-separated list of allowed origins for the API, e.g. https://www.yourdomain.com
ALLOWED_ORIGINS=
